# ==============================================================
# OpenRouter Configuration (Multi-Token & Multi-Model Pool)
# ==============================================================
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemini-2.0-flash-001,openai/gpt-4o-mini

# ==============================================================
# Firebase & Cloud Firestore Configuration
# ==============================================================
# OPTION 1: Inline service credentials
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# OPTION 2: Service account JSON key file path
# FIREBASE_SERVICE_ACCOUNT_KEY_PATH=./service-account.json
# GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# Firestore Collection Name
FIRESTORE_USERS_COLLECTION=users

# ==============================================================
# Google OAuth & Authentication Configuration
# ==============================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:5001/api/v1/auth/google/callback
FRONTEND_URL=http://localhost:3000

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key
JWT_EXPIRES_IN=7d

# Server & Generator Configuration
PORT=5001
API_PREFIX=/api/v1
TARGET_PER_SUBJECT=200
BATCH_SIZE=10
