# ==============================================================
# OpenRouter Configuration (Multi-Token & Multi-Model Pool)
# ==============================================================
OPENROUTER_API_KEYS=sk-or-v1-key1,sk-or-v1-key2,sk-or-v1-key3
OPENROUTER_MODELS=nvidia/nemotron-3-ultra-550b-a55b:free,google/gemini-2.0-flash-001,openai/gpt-4o-mini

# ==============================================================
# Firebase & Cloud Firestore Configuration
# ==============================================================
FIREBASE_PROJECT_ID=projectid
FIREBASE_CLIENT_EMAIL=your-service-account@projectid.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Firestore Collection Names
FIRESTORE_USERS_COLLECTION=users
FIRESTORE_REVOKED_TOKENS_COLLECTION=revoked_tokens

# ==============================================================
# Google OAuth & Authentication Configuration
# ==============================================================
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=https://study2ool.firebaseapp.com/__/auth/handler
FRONTEND_URL=http://localhost:3000

# JWT Configuration
# Tokens do not have a time-based expiration date; they expire ONLY when the user logs out.
JWT_SECRET=your-super-secret-jwt-key

# Server & Generator Configuration
PORT=5001
API_PREFIX=/api/v1
TARGET_PER_SUBJECT=200
BATCH_SIZE=10
